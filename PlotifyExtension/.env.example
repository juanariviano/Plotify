# sama dengan PlotifyFrontend. pakai pk_live_ untuk build yang di-upload ke chrome web store
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
VITE_BACKEND_URL=http://localhost:5003
# web app plotify, dipakai untuk link "open in plotify" dan halaman sign in
VITE_PLOTIFY_URL=http://localhost:5173

# opsional. default: VITE_PLOTIFY_URL untuk pk_test_, https://<frontend api clerk> untuk pk_live_
# VITE_CLERK_SYNC_HOST=

# opsional, hanya untuk build lokal: public key supaya id extension tidak berubah.
# kosongkan saat build untuk chrome web store (store menolak field "key")
EXTENSION_KEY=
